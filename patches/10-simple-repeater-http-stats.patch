+static void mqttStopClient() {
+  if (!g_mqtt_client) return;
+  if (g_mqtt_started) {
+    esp_mqtt_client_stop(g_mqtt_client);
+  }
+  esp_mqtt_client_destroy(g_mqtt_client);
+  g_mqtt_client = NULL;
+  g_mqtt_started = false;
+  g_mqtt_stats.connected = false;
+}
+
+static bool mqttPublish(const char* topic, const String& payload, bool retain = false) {
+  if (!g_mqtt_client || !g_mqtt_stats.connected || !topic || topic[0] == 0) {
+    g_mqtt_stats.publish_fail++;
+    return false;
+  }
+  int msg_id = esp_mqtt_client_enqueue(g_mqtt_client, topic, payload.c_str(), payload.length(), 0, retain ? 1 : 0, true);
+  if (msg_id < 0) {
+    g_mqtt_stats.publish_fail++;
+    Serial.printf("[MQTT] Publish failed: %s\n", topic);
+    return false;
+  }
+  g_mqtt_stats.publish_ok++;
+  return true;
+}
+
+static void mqttPublishStatus(const char* status, uint32_t now_epoch, bool retain) {
+  if (!g_mqtt_topic_status[0]) return;
+  String payload = mqttBuildStatusJson(status, now_epoch);
+  mqttPublish(g_mqtt_topic_status, payload, retain);
+}
+
+static void mqttPublishRawFrame(const uint8_t* raw, int len, uint32_t now_epoch) {
+  if (!raw || len <= 0 || !g_mqtt_topic_raw[0]) return;
+  String iso;
+  String t;
+  String d;
+  mqttBuildTimeFields(now_epoch, iso, t, d);
+
+  String payload;
+  payload.reserve(len * 2 + 256);
+  payload += "{";
+  payload += "\"origin\":\"" + mqttJsonEscape(String(g_mqtt_origin_name)) + "\",";
+  payload += "\"origin_id\":\"" + mqttJsonEscape(String(g_mqtt_node_pub_hex_upper)) + "\",";
+  payload += "\"timestamp\":\"" + mqttJsonEscape(iso) + "\",";
+  payload += "\"type\":\"RAW\",";
+  payload += "\"time\":\"" + mqttJsonEscape(t) + "\",";
+  payload += "\"date\":\"" + mqttJsonEscape(d) + "\",";
+  payload += "\"raw\":\"" + mqttBytesToHex(raw, (size_t)len) + "\"";
+  payload += "}";
+  mqttPublish(g_mqtt_topic_raw, payload, false);
+}
+
+static void mqttPublishMeshPacket(const mesh::Packet* pkt, int len, const char* direction, float score, bool include_rx_metrics, int last_snr, int last_rssi, uint32_t now_epoch) {
+  if (!pkt || !g_mqtt_topic_packets[0]) return;
+
+  uint8_t raw_buf[MAX_TRANS_UNIT + 4];
+  int raw_len = pkt->writeTo(raw_buf);
+  if (raw_len <= 0) return;
+
+  uint8_t hash[MAX_HASH_SIZE];
+  pkt->calculatePacketHash(hash);
+  char hash_hex[MAX_HASH_SIZE * 2 + 1];
+  mesh::Utils::toHex(hash_hex, hash, MAX_HASH_SIZE);
+
+  String iso;
+  String t;
+  String d;
+  mqttBuildTimeFields(now_epoch, iso, t, d);
+
+  String payload;
+  payload.reserve(raw_len * 2 + 512);
+  String dir = direction ? String(direction) : String("rx");
+  dir.toLowerCase();
+  payload += "{";
+  payload += "\"origin\":\"" + mqttJsonEscape(String(g_mqtt_origin_name)) + "\",";
+  payload += "\"origin_id\":\"" + mqttJsonEscape(String(g_mqtt_node_pub_hex_upper)) + "\",";
+  payload += "\"timestamp\":\"" + mqttJsonEscape(iso) + "\",";
+  payload += "\"type\":\"PACKET\",";
+  payload += "\"direction\":\"" + mqttJsonEscape(dir) + "\",";
+  payload += "\"time\":\"" + mqttJsonEscape(t) + "\",";
+  payload += "\"date\":\"" + mqttJsonEscape(d) + "\",";
+  payload += "\"len\":\"" + String(len) + "\",";
+  payload += "\"packet_type\":\"" + String((unsigned int)pkt->getPayloadType()) + "\",";
+  payload += "\"route\":\"" + String(pkt->isRouteDirect() ? "D" : "F") + "\",";
+  payload += "\"payload_len\":\"" + String((unsigned int)pkt->payload_len) + "\",";
+  payload += "\"raw\":\"" + mqttBytesToHex(raw_buf, (size_t)raw_len) + "\",";
+  payload += "\"hash\":\"" + String(hash_hex) + "\"";
+  if (include_rx_metrics) {
+    payload += ",\"SNR\":\"" + String((int)last_snr) + "\"";
+    payload += ",\"RSSI\":\"" + String((int)last_rssi) + "\"";
+    payload += ",\"score\":\"" + String((int)(score * 1000.0f)) + "\"";
+  }
+  payload += "}";
+  mqttPublish(g_mqtt_topic_packets, payload, false);
+}
+
+static void mqttEventHandler(void* handler_args, esp_event_base_t base, int32_t event_id, void* event_data) {
+  (void)handler_args;
+  (void)base;
+  esp_mqtt_event_handle_t event = (esp_mqtt_event_handle_t)event_data;
+  switch ((esp_mqtt_event_id_t)event_id) {
+    case MQTT_EVENT_CONNECTED:
+      g_mqtt_stats.connected = true;
+      g_mqtt_stats.last_error_code = 0;
+      if (g_mqtt_seen_connected) g_mqtt_stats.reconnects++;
+      g_mqtt_seen_connected = true;
+      g_mqtt_last_profile = g_mqtt_active_profile;
+      g_mqtt_connect_started_at = 0;
+      g_mqtt_backoff_ms = 1000;
+      httpUiLogf("MQTT connected: %s (%s)",
+                 g_mqtt_active_profile_name[0] ? g_mqtt_active_profile_name : "unknown",
+                 g_mqtt_active_host[0] ? g_mqtt_active_host : "-");
+      break;
+    case MQTT_EVENT_DISCONNECTED:
+      g_mqtt_stats.connected = false;
+      g_mqtt_needs_reconnect = true;
+      g_mqtt_active_profile = mqttNextProfileIndex(g_mqtt_active_profile);
+      httpUiLogf("MQTT disconnected: %s", g_mqtt_active_host[0] ? g_mqtt_active_host : "-");
+      mqttSetReconnectDelay(g_mqtt_backoff_ms);
+      if (g_mqtt_backoff_ms < 120000) g_mqtt_backoff_ms *= 2;
+      break;
+    case MQTT_EVENT_ERROR:
+      g_mqtt_stats.connected = false;
+      g_mqtt_needs_reconnect = true;
+      g_mqtt_active_profile = mqttNextProfileIndex(g_mqtt_active_profile);
+      if (event && event->error_handle) {
+        g_mqtt_stats.last_error_code = event->error_handle->esp_tls_last_esp_err;
+        Serial.printf("[MQTT] Error: type=%d tls_err=0x%X tls_stack=0x%X sock_errno=%d conn_rc=%d\n",
+                      (int)event->error_handle->error_type,
+                      (unsigned int)event->error_handle->esp_tls_last_esp_err,
+                      (unsigned int)event->error_handle->esp_tls_stack_err,
+                      (int)event->error_handle->esp_transport_sock_errno,
+                      (int)event->error_handle->connect_return_code);
+        httpUiLogf("MQTT error tls=0x%X sock=%d rc=%d",
+                   (unsigned int)event->error_handle->esp_tls_last_esp_err,
+                   (int)event->error_handle->esp_transport_sock_errno,
+                   (int)event->error_handle->connect_return_code);
+      } else {
+        g_mqtt_stats.last_error_code = -1;
+        Serial.println("[MQTT] Error: missing error_handle");
+        httpUiLogf("MQTT error: missing error_handle");
+      }
+      mqttSetReconnectDelay(g_mqtt_backoff_ms);
+      if (g_mqtt_backoff_ms < 120000) g_mqtt_backoff_ms *= 2;
+      break;
+    default:
+      break;
+  }
+}
+
+static bool mqttStartClient(const mesh::LocalIdentity& self_id, const char* origin_name, uint32_t now_epoch) {
+  if (g_mqtt_active_profile < 0) g_mqtt_active_profile = mqttNextProfileIndex(-1);
+
+  MqttBrokerProfile profile = {};
+  if (g_mqtt_active_profile < 0 || !mqttResolveProfile(g_mqtt_active_profile, profile) || !profile.host || profile.host[0] == 0) {
+    mqttStopClient();
+    return false;
+  }
+
+  mesh::Utils::toHex(g_mqtt_node_pub_hex, self_id.pub_key, PUB_KEY_SIZE);
+  memset(g_mqtt_node_pub_hex_upper, 0, sizeof(g_mqtt_node_pub_hex_upper));
+  for (size_t i = 0; i < sizeof(g_mqtt_node_pub_hex_upper) - 1; i++) {
+    char ch = g_mqtt_node_pub_hex[i];
+    if (ch == 0) break;
+    g_mqtt_node_pub_hex_upper[i] = (char)toupper((unsigned char)ch);
+  }
+  StrHelper::strncpy(g_mqtt_origin_name, origin_name ? origin_name : "unknown", sizeof(g_mqtt_origin_name));
+
+  String iata = String(MQTT_IATA);
+  iata.toUpperCase();
+  iata.trim();
+  if (iata.length() > 3) iata = iata.substring(0, 3);
+  if (iata.length() == 0) iata = "XXX";
+
+  String status_t = mqttResolveTopicTemplate(MQTT_TOPIC_STATUS, iata.c_str(), g_mqtt_node_pub_hex_upper);
+  String packets_t = mqttResolveTopicTemplate(MQTT_TOPIC_PACKETS, iata.c_str(), g_mqtt_node_pub_hex_upper);
+  String raw_t = mqttResolveTopicTemplate(MQTT_TOPIC_RAW, iata.c_str(), g_mqtt_node_pub_hex_upper);
+  StrHelper::strncpy(g_mqtt_topic_status, status_t.c_str(), sizeof(g_mqtt_topic_status));
+  StrHelper::strncpy(g_mqtt_topic_packets, packets_t.c_str(), sizeof(g_mqtt_topic_packets));
+  StrHelper::strncpy(g_mqtt_topic_raw, raw_t.c_str(), sizeof(g_mqtt_topic_raw));
+
+  String transport = String(profile.transport ? profile.transport : "tcp");
+  transport.toLowerCase();
+  transport.trim();
+  if (transport == "ws" || transport == "wss") transport = "websockets";
+  bool is_ws = (transport == "websockets");
+
+  String uri = is_ws ? (profile.tls_enabled ? "wss://" : "ws://") : (profile.tls_enabled ? "mqtts://" : "mqtt://");
+  uri += String(profile.host);
+  uri += ":";
+  uri += String((unsigned int)profile.port);
+  if (is_ws) {
+    String ws_path = String(profile.ws_path ? profile.ws_path : "/");
+    ws_path.trim();
+    if (ws_path.length() == 0) ws_path = "/";
+    if (!ws_path.startsWith("/")) ws_path = "/" + ws_path;
+    uri += ws_path;
+  }
+  StrHelper::strncpy(g_mqtt_uri, uri.c_str(), sizeof(g_mqtt_uri));
+  StrHelper::strncpy(g_mqtt_active_profile_name, profile.name ? profile.name : "unknown", sizeof(g_mqtt_active_profile_name));
+  StrHelper::strncpy(g_mqtt_active_host, profile.host ? profile.host : "", sizeof(g_mqtt_active_host));
+
+  if (profile.client_id && profile.client_id[0]) {
+    StrHelper::strncpy(g_mqtt_client_id, profile.client_id, sizeof(g_mqtt_client_id));
+  } else {
+    String generated_id = "meshcore_" + String(g_mqtt_node_pub_hex_upper);
+    if (generated_id.length() > 23) generated_id = generated_id.substring(0, 23);
+    StrHelper::strncpy(g_mqtt_client_id, generated_id.c_str(), sizeof(g_mqtt_client_id));
+  }
+
+  g_mqtt_username[0] = 0;
+  g_mqtt_password[0] = 0;
+  String auth = String(profile.auth_method ? profile.auth_method : "none");
+  auth.toLowerCase();
+  auth.trim();
+  if (auth == "password") {
+    StrHelper::strncpy(g_mqtt_username, profile.username ? profile.username : "", sizeof(g_mqtt_username));
+    StrHelper::strncpy(g_mqtt_password, profile.password ? profile.password : "", sizeof(g_mqtt_password));
+  } else if (auth == "token") {
+    String user = "v1_" + String(g_mqtt_node_pub_hex_upper);
+    String token = mqttBuildJwtToken(self_id, now_epoch, profile.audience, profile.owner, profile.email,
+                                     profile.tls_enabled && profile.tls_verify);
+    StrHelper::strncpy(g_mqtt_username, user.c_str(), sizeof(g_mqtt_username));
+    StrHelper::strncpy(g_mqtt_password, token.c_str(), sizeof(g_mqtt_password));
+  }
+
+  String offline_payload = mqttBuildStatusJson("offline", now_epoch);
+  StrHelper::strncpy(g_mqtt_lwt_payload, offline_payload.c_str(), sizeof(g_mqtt_lwt_payload));
+
+  mqttStopClient();
+
+  esp_mqtt_client_config_t mqtt_cfg = {};
+  mqtt_cfg.uri = g_mqtt_uri;
+  mqtt_cfg.client_id = g_mqtt_client_id;
+  mqtt_cfg.keepalive = profile.keepalive ? profile.keepalive : MQTT_KEEPALIVE;
+  mqtt_cfg.disable_auto_reconnect = true;
+  mqtt_cfg.skip_cert_common_name_check = profile.tls_enabled && !profile.tls_verify;
+  if (profile.tls_enabled && profile.tls_verify) {
+    if (arduino_esp_crt_bundle_attach) {
+      mqtt_cfg.crt_bundle_attach = arduino_esp_crt_bundle_attach;
+    } else if (esp_crt_bundle_attach) {
+      mqtt_cfg.crt_bundle_attach = esp_crt_bundle_attach;
+    } else if (strstr(profile.host, "letsmesh.net") != nullptr) {
+      mqtt_cfg.cert_pem = kLetsMeshGoogleCaPem;
+      Serial.println("[MQTT] Using built-in LetsMesh CA chain");
+    } else {
+      Serial.println("[MQTT] Warning: no certificate bundle symbol available (set TLS verify off for custom broker)");
+    }
+  }
+  if (g_mqtt_username[0]) mqtt_cfg.username = g_mqtt_username;
+  if (g_mqtt_password[0]) mqtt_cfg.password = g_mqtt_password;
+  if (g_mqtt_topic_status[0]) {
+    mqtt_cfg.lwt_topic = g_mqtt_topic_status;
+    mqtt_cfg.lwt_msg = g_mqtt_lwt_payload;
+    mqtt_cfg.lwt_msg_len = strlen(g_mqtt_lwt_payload);
+    mqtt_cfg.lwt_retain = 1;
+    mqtt_cfg.lwt_qos = 0;
+  }
+
+  g_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+  if (!g_mqtt_client) {
+    g_mqtt_stats.last_error_code = -2;
+    httpUiLogf("MQTT init failed: %s", g_mqtt_active_host[0] ? g_mqtt_active_host : "-");
+    return false;
+  }
+
+  Serial.printf("[MQTT] Starting profile '%s' -> %s\n", profile.name ? profile.name : "unknown", g_mqtt_uri);
+  httpUiLogf("MQTT connecting: %s (%s)",
+             g_mqtt_active_profile_name[0] ? g_mqtt_active_profile_name : "unknown",
+             g_mqtt_active_host[0] ? g_mqtt_active_host : "-");
+
+  esp_mqtt_client_register_event(g_mqtt_client, MQTT_EVENT_ANY, mqttEventHandler, NULL);
+  esp_err_t start_err = esp_mqtt_client_start(g_mqtt_client);
+  if (start_err != ESP_OK) {
+    g_mqtt_stats.last_error_code = start_err;
+    mqttStopClient();
+    httpUiLogf("MQTT start failed err=%ld", (long)start_err);
+    return false;
+  }
+
+  g_mqtt_started = true;
+  g_mqtt_connect_started_at = millis();
+  g_mqtt_stats.connect_attempts++;
+  g_mqtt_needs_reconnect = false;
+  return true;
+}
+
+static void mqttEnsureRuntime(const mesh::LocalIdentity& self_id, const char* origin_name, uint32_t now_epoch) {
+  if (WiFi.status() != WL_CONNECTED) {
+    mqttStopClient();
+    g_mqtt_needs_reconnect = true;
+    return;
+  }
+
+  if (mqttProfileCount() <= 0) {
+    mqttStopClient();
+    g_mqtt_needs_reconnect = false;
+    return;
+  }
+
+  if (g_mqtt_active_profile < 0) g_mqtt_active_profile = mqttNextProfileIndex(-1);
+
+  if (g_mqtt_started && !g_mqtt_stats.connected && g_mqtt_connect_started_at > 0 && (millis() - g_mqtt_connect_started_at) > 15000) {
+    mqttStopClient();
+    g_mqtt_needs_reconnect = true;
+    g_mqtt_active_profile = mqttNextProfileIndex(g_mqtt_active_profile);
+    mqttSetReconnectDelay(g_mqtt_backoff_ms);
+  }
+
+  if (g_mqtt_needs_reconnect) {
+    if ((int32_t)(millis() - g_mqtt_next_reconnect_at) < 0) return;
+    if (!mqttStartClient(self_id, origin_name, now_epoch)) {
+      g_mqtt_active_profile = mqttNextProfileIndex(g_mqtt_active_profile);
+      mqttSetReconnectDelay(g_mqtt_backoff_ms);
+      if (g_mqtt_backoff_ms < 120000) g_mqtt_backoff_ms *= 2;
+    }
+  }
+}
