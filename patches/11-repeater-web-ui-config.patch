+static void httpUiLogf(const char* fmt, ...) {
+  if (!fmt || !fmt[0]) return;
+  char line[120];
+  va_list ap;
+  va_start(ap, fmt);
+  vsnprintf(line, sizeof(line), fmt, ap);
+  va_end(ap);
+  HttpUiLogEntry* dst = &g_http_ui_logs[g_http_ui_log_next];
+  dst->ts = rtc_clock.getCurrentTime();
+  StrHelper::strncpy(dst->msg, line, sizeof(dst->msg));
+  g_http_ui_log_next = (uint8_t)((g_http_ui_log_next + 1) % (sizeof(g_http_ui_logs) / sizeof(g_http_ui_logs[0])));
+  if (g_http_ui_log_count < (sizeof(g_http_ui_logs) / sizeof(g_http_ui_logs[0]))) {
+    g_http_ui_log_count++;
+  }
+}
